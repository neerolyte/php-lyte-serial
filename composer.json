{
  "name": "lyte/serial",
  "description": "A safe unserializer for PHP serialized arrays and scalar types.",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "David Schoen",
      "email": "dave@lyte.id.au"
    }
  ],
  "require": {
    "php": ">=7.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "php-coveralls/php-coveralls": "^2.5"
  },
  "scripts": {
    "test": [
      "phpunit"
    ]
  },
  "autoload": {
    "psr-4": {
      "Lyte\\Serial\\": "src/",
      "Lyte\\Serial\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "7.3.33"
    }
  }
}
